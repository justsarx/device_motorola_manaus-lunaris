From 5e6fd320225e320c34c8141297af431538a4b6a9 Mon Sep 17 00:00:00 2001
From: Alcatraz323 <alcatraz32323@gmail.com>
Date: Wed, 7 Jan 2026 16:42:15 +0800
Subject: [PATCH] bluetooth: Introduce Savitech LHDC Codec [1/5]

Import Savitech LHDC Codec from https://gitlab.com/savitech-lhdc/
---
 libc/Android.bp | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/libc/Android.bp b/libc/Android.bp
index 5cd88af5a..c35b005be 100644
--- a/libc/Android.bp
+++ b/libc/Android.bp
@@ -1768,9 +1768,9 @@ cc_defaults {
     ],
     static_ndk_lib: true,
     static_libs: ["libasync_safe"],
-    apex_available: [
-        "//apex_available:platform",
-    ],
+    //apex_available: [
+    //    "//apex_available:platform",
+    //],
 
     static: {
         system_shared_libs: [],
@@ -1800,6 +1800,11 @@ cc_defaults {
             version_script: ":libstdc++.x86_64.map",
         },
     },
+    apex_available: [
+        "//apex_available:platform",
+        "com.android.bt",
+    ],
+    min_sdk_version: "33",
 }
 
 cc_library {
